# Copy to .env (or export these variables) to override defaults.
# No API keys are required: everything runs locally.

# Ollama chat model used for answer generation.
# Default matches the vision model below so one
# installed Qwen covers both jobs; set this to the
# tag `ollama list` actually shows on your machine.
RAG_MODEL=qwen3-vl:4b-instruct

# Ollama vision model used for pages where text
# extraction fails
RAG_VISION_MODEL=qwen3-vl:4b-instruct

# Sentence-Transformers embedding model
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path to the Tesseract binary (only needed for the
# optional OCR experiments)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
